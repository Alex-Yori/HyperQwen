# Everything in this repo executes on Linux (bash, patch, python inside the
# container image via `COPY . .`), so CRLF working trees break it. Force LF
# regardless of the cloning machine's core.autocrlf.
* text=auto eol=lf
# Patch context lines start with a literal space. Do not report those mandatory
# diff markers as trailing whitespace when a new patch file is reviewed.
*.patch whitespace=-trailing-space
